{
  "name": "@bubbacore/elvis",
  "version": "0.4.0",
  "description": "Marca e valores-base do Bubba: logo, cores, fontes, espaçamento, cantos e foco.",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bubbacore/elvis.git"
  },
  "homepage": "https://github.com/bubbacore/elvis#readme",
  "bugs": "https://github.com/bubbacore/elvis/issues",
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./logo/*": "./dist/logo/*",
    "./exports/*": "./dist/exports/*",
    "./usage-rules.md": "./dist/usage-rules.md",
    "./voice.md": "./dist/voice.md",
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "biome ci . && tsc --noEmit && node scripts/check.ts",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "style-dictionary": "5.6.1",
    "subset-font": "2.9.0",
    "typescript": "7.0.2"
  }
}
