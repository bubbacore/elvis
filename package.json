{
  "name": "@bubbacore/elvis",
  "version": "0.0.0",
  "private": true,
  "description": "Marca e valores-base do Bubba: logo, cores, fontes, espaçamento, cantos e foco.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "biome ci . && tsc --noEmit && node scripts/check.ts",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "style-dictionary": "5.6.1",
    "subset-font": "2.9.0",
    "typescript": "7.0.2"
  }
}
