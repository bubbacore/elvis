{
  "$description": "Tokens primitivos do Bubba, no formato DTCG 2025.10. Guardam os valores brutos aprovados e são internos: não fazem parte do contrato público, e só os tokens semânticos devem referenciá-los.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "gray": {
        "50": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.968627, 0.968627, 0.968627], "hex": "#f7f7f7" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.921569, 0.921569, 0.921569], "hex": "#ebebeb" }
        },
        "300": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.690196, 0.686275, 0.686275], "hex": "#b0afaf" }
        },
        "500": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.443137, 0.443137, 0.443137], "hex": "#717171" }
        },
        "700": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.313725, 0.301961, 0.301961], "hex": "#504d4d" }
        },
        "950": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.019608, 0.019608, 0.019608], "hex": "#050505" }
        }
      },
      "blue": {
        "50": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.913725, 0.937255, 0.964706], "hex": "#e9eff6" }
        },
        "200": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.788235, 0.839216, 0.913725], "hex": "#c9d6e9" }
        },
        "300": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.647059, 0.733333, 0.858824], "hex": "#a5bbdb" }
        },
        "500": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.443137, 0.564706, 0.737255], "hex": "#7190bc" }
        },
        "600": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.286275, 0.431373, 0.631373], "hex": "#496ea1" }
        }
      },
      "coral": {
