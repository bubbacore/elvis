      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium": { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 }
      },
      "width": {
        "extra-condensed": { "$type": "number", "$value": 62.5 }
      },
      "line-height": {
        "110": { "$type": "number", "$value": 1.1 },
        "120": { "$type": "number", "$value": 1.2 },
        "140": { "$type": "number", "$value": 1.4 },
