{
  "$description": "Tokens primitivos do Bubba, no formato DTCG 2025.10. Guardam os valores brutos aprovados e são internos: não fazem parte do contrato público, e só os tokens semânticos devem referenciá-los.",
  "primitive": {
    "color": {
      "white": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
      },
      "gray-blue": {
        "50": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.952941, 0.960784, 0.984314], "hex": "#f3f5fb" }
        },
        "100": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.933333, 0.941176, 0.960784], "hex": "#eef0f5" }
        },
        "200": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.866667, 0.882353, 0.92549], "hex": "#dde1ec" }
        },
        "500": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.494118, 0.52549, 0.639216], "hex": "#7e86a3" }
        },
        "700": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.294118, 0.321569, 0.447059], "hex": "#4b5272" }
        },
        "950": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.05098, 0.07451, 0.188235], "hex": "#0d1330" }
        }
      },
      "blue": {
        "900": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.003922, 0.113725, 0.592157], "hex": "#011d97" }
        }
      },
      "red": {
        "700": {
          "$type": "color",
          "$value": { "colorSpace": "srgb", "components": [0.780392, 0.086275, 0.082353], "hex": "#c71615" }
        }
      }
    },
    "dimension": {
      "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "1": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
