          "$value": { "colorSpace": "srgb", "components": [0.878431, 0.203922, 0.019608], "hex": "#e03405" }
        }
      }
    },
    "dimension": {
      "1": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
      "4": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "8": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "11": { "$type": "dimension", "$value": { "value": 11, "unit": "px" } },
      "12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "15": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
      "16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "17": { "$type": "dimension", "$value": { "value": 17, "unit": "px" } },
      "18": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
