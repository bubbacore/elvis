      "22": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
      "24": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "28": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
      "30": { "$type": "dimension", "$value": { "value": 30, "unit": "px" } },
      "32": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "36": { "$type": "dimension", "$value": { "value": 36, "unit": "px" } },
      "40": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "56": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
      "80": { "$type": "dimension", "$value": { "value": 80, "unit": "px" } },
      "960": { "$type": "dimension", "$value": { "value": 960, "unit": "px" } },
      "999": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
    },
    "font": {
      "family": {
        "playfair-display": { "$type": "fontFamily", "$value": "Playfair Display" },
        "antonio": { "$type": "fontFamily", "$value": "Antonio" }
      },
      "weight": {
        "light": { "$type": "fontWeight", "$value": 300 },
        "regular": { "$type": "fontWeight", "$value": 400 },
        "medium": { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold": { "$type": "fontWeight", "$value": 700 }
      },
      "line-height": {
        "100": { "$type": "number", "$value": 1 },
        "105": { "$type": "number", "$value": 1.05 },
        "112": { "$type": "number", "$value": 1.12 },
        "120": { "$type": "number", "$value": 1.2 },
        "125": { "$type": "number", "$value": 1.25 },
        "130": { "$type": "number", "$value": 1.3 },
        "150": { "$type": "number", "$value": 1.5 },
        "155": { "$type": "number", "$value": 1.55 }
      },
      "letter-spacing": {
        "$description": "Espaço entre letras em px, já multiplicado pelo tamanho de cada nível a partir do valor aprovado em em. O nome é o valor em centésimos de pixel, com n para os negativos: n112 é -1,12 px.",
        "n112": { "$type": "dimension", "$value": { "value": -1.12, "unit": "px" } },
        "n80": { "$type": "dimension", "$value": { "value": -0.8, "unit": "px" } },
        "n54": { "$type": "dimension", "$value": { "value": -0.54, "unit": "px" } },
        "n45": { "$type": "dimension", "$value": { "value": -0.45, "unit": "px" } },
        "n28": { "$type": "dimension", "$value": { "value": -0.28, "unit": "px" } },
        "n24": { "$type": "dimension", "$value": { "value": -0.24, "unit": "px" } },
        "n22": { "$type": "dimension", "$value": { "value": -0.22, "unit": "px" } },
        "n20": { "$type": "dimension", "$value": { "value": -0.2, "unit": "px" } },
        "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
        "24": { "$type": "dimension", "$value": { "value": 0.24, "unit": "px" } },
        "55": { "$type": "dimension", "$value": { "value": 0.55, "unit": "px" } },
        "60": { "$type": "dimension", "$value": { "value": 0.6, "unit": "px" } }
